# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Prospecting APIs
CLAY_API_KEY=your_clay_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here

# Enrichment APIs
CLEARBIT_API_KEY=your_clearbit_api_key_here
PDL_API_KEY=your_pdl_api_key_here

# Email APIs
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your-email@domain.com
SENDGRID_FROM_NAME=Your Name

# Google Sheets API
GOOGLE_SHEETS_CREDS=./configs/service_account.json
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Database Configuration
DATABASE_PATH=./database/prospect_workflow.db

# Application Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# Logging Configuration
LOG_DIR=./logs
LOG_LEVEL=INFO
ENABLE_FULL_TRACES=False

# Rate Limiting
MAX_LEADS_PER_RUN=50
MAX_LEADS_PER_DAY=200

